<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rosary_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/widget_background">

    <TextView
        android:id="@+id/rosary_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#D9AD55"
        android:textSize="15sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/rosary_where"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="#EFE5CF"
        android:textSize="13sp"
        android:maxLines="2"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/rosary_beads"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:textColor="#D9AD55"
        android:textSize="20sp"
        android:maxLines="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/rosary_minus"
            android:layout_width="48dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:text="−"
            android:contentDescription="Reculer d'un grain"
            android:textColor="#D9AD55"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/rosary_plus"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:gravity="center"
            android:background="@drawable/widget_button"
            android:text="+ 1 grain"
            android:textColor="#0E1A36"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/rosary_open"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="4dp"
            android:text="Reprendre"
            android:textColor="#D9AD55"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
